# API origin of your existing Render/Node backend, without a trailing slash.
# The browser calls {origin}/api/dash/* and {origin}/api/telemetry/stream.
NEXT_PUBLIC_DASH_API_ORIGIN=

# Optional explicit WS telemetry origin, e.g. wss://your-backend.example
NEXT_PUBLIC_TELEMETRY_WS_ORIGIN=

# Optional LiveKit room. Tokens must be minted by your backend, never in the browser.
NEXT_PUBLIC_LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_ROOM=
NEXT_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=/api/livekit/token
