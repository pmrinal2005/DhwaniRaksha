# ─────────────────────────────────────────────────────────────────────────────
# Dhwani-Raksha Ω — server environment
# Copy to apps/web/.env.local for local runs, or paste into
# Vercel → Project → Settings → Environment Variables (Production + Preview).
# Every value below is read server-side only. Nothing secret reaches the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gnani (api.vachana.ai) ───────────────────────────────────────────────────
# Sent as the `X-API-Key-ID` header exactly as documented at
# https://docs.gnani.ai/api/introduction/authentication
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# true (default) keeps all 3,000 credits: every Gnani call is served by the
# deterministic simulator in lib/gnani/mock.ts, which still produces a real
# 1,536-byte bfloat16 embedding, real 8 kHz µ-law, and real hash-chained receipts.
USE_GNANI_MOCK=true

# Hard ceiling (configured in lib/server/catalog.ts → GOAL.credits = 3000 and
# GOAL.hardStopFloor = 150). Kept here as documentation so operators know the budget;
# the firewall clamps every call against these numbers, not against the network.

# ── Supabase / pgvector (optional) ──────────────────────────────────────────
# Without these the store runs in `sim` mode (in-memory); the UI reports the mode.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Groq judge (optional, two keys = two models) ────────────────────────────
# GROQ_API_KEY_1 → llama-3.1-8b-instant        (transcript conditioning)
# GROQ_API_KEY_2 → llama-3.3-70b-versatile     (structured contract JSON)
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# ── LiveKit dual-voice bridge (optional) ────────────────────────────────────
# Without these /api/livekit/token answers 501 and the bridge panel says so.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=dhwani-raksha-bridge

# ── Public (browser-visible) ────────────────────────────────────────────────
NEXT_PUBLIC_LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_ROOM=dhwani-raksha-bridge
